{
  "name": "pausa-five-fe",
  "version": "0.0.0",
  "scripts": {
    "ng": "node tools/ng.mjs",
    "start": "node tools/ng.mjs serve",
    "build": "node tools/ng.mjs build",
    "watch": "node tools/ng.mjs build --watch --configuration development",
    "test": "node tools/ng.mjs test",
    "lint": "eslint src e2e playwright.config.ts --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\" \"*.{json,mjs}\" \"tools/*.mjs\" \".github/workflows/*.{yml,yaml}\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\" \"*.{json,mjs}\" \"tools/*.mjs\" \".github/workflows/*.{yml,yaml}\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "test:ci": "npm run test:dictionary && node tools/ng.mjs test --watch=false --reporters=junit --reporters=default --output-file=test-results/unit.xml",
    "validate:dictionary": "node tools/validate-dictionary.mjs",
    "test:dictionary": "node --test tools/validate-dictionary.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:types": "tsc -p tsconfig.e2e.json"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "22.2.4",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "22.2.3",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "22.2.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "9.39.4",
    "@types/node": "24.13.3",
    "angular-eslint": "22.0.0",
    "eslint": "9.39.4",
    "jsdom": "^30.0.0",
    "playwright": "1.63.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "24.16.0",
    "npm": "11.13.0"
  },
  "overrides": {
    "@angular/build": {
      "vite": "8.3.4"
    }
  }
}
